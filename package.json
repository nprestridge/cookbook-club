{
  "name": "cookbook-club",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.53.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^23.2.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.5",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "stylelint-order": "^6.0.3",
    "vite": "^5.0.8",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "^6.18.0",
    "reactstrap": "^9.2.0"
  },
  "scripts": {
    "build:css": "sass src:src",
    "watch:css": "npm run build:css && sass --watch src:src",
    "start:vite": "vite",
    "start": "npm-run-all -p watch:css start:vite",
    "build:js": "vite build",
    "build": "npm-run-all build:css build:js",
    "test:lint-js": "eslint 'src/**/*.js' 'src/**/*.jsx'",
    "test:lint-css": "stylelint **/*.scss",
    "test:unit": "vitest",
    "test:unit:ci": "npm run test:lint-js && npm run test:lint-css && vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test": "run-s test:lint-js test:lint-css test:unit:ci"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
